{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "palette": {
        "text":             "#494D64",
        "base-os":          "#ACB0BE",
        "base-pink":        "#F5BDE6",
        "base-lavender":    "#B7BDF8",
        "base-blue":        "#8AADF4",
        "base-wight":       "#FFFFFF",
        "base-interrupt":   "#da352d",
        "os":               "light-gradient(p:base-os)",
        "pink":             "light-gradient(p:base-pink)",
        "lavender":         "light-gradient(p:base-lavender)",
        "blue":             "light-gradient(p:base-blue)",
        "wight":            "light-gradient(p:base-wight)",
        "interrupt":        "light-gradient(p:base-interrupt)"
    },
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "background": "p:base-blue",
                    "foreground": "p:text",
                    "powerline_symbol": "\ue0b6",
                    "style": "powerline",
                    "invert_powerline": true,
                    "template": "{{.Icon}}",
                    "type": "os"
                },
                {
                    "background": "p:blue",
                    "foreground": "p:text",
                    "trailing_diamond": "\ue0b4",
                    "style": "diamond",
                    "template": "{{ .UserName }}@{{ .HostName }}",
                    "type": "session"
                },
                {
                    "background": "p:pink",
                    "foreground": "p:text",
                    "options": {
                        "folder_icon": "\ue5fe",
                        "home_icon": "~",
                        "style": "agnoster_short"
                    },
                    "powerline_symbol": "\ue0b4",
                    "style": "powerline",
                    "template": " {{ .Path }}",
                    "type": "path"
                },
                {
                    "background": "p:lavender",
                    "foreground": "p:text",
                    "style": "powerline",
                    "options": {
                        "branch_icon": "\ue725 ",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 ",
                        "branch_template": "{{ trunc 25 .Branch }}",
                        "fetch_status": false,
                        "fetch_upstream_icon": true
                    },
                    "powerline_symbol": "\ue0b4",
                    "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }} {{ .HEAD }}",
                    "type": "git"
                }
            ],
            "type": "prompt"
        },
        {
            "segments": [
                {
                    "foreground": "p:text",
                    "background_templates": [
                        "{{if eq \"Charging\" .State.String}}p:wight{{end}}",
                        "{{if eq \"Discharging\" .State.String}}p:os{{end}}",
                        "{{if eq \"Full\" .State.String}}p:pink{{end}}",
                        "p:pink"
                    ],
                    "leading_diamond": "\ue0b6",
                    "trailing_diamond": "\ue0b4",
                    "style": "diamond",
                    "template": "{{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 \ueb2d",
                    "type": "battery"
                },
                {
                    "background": "p:lavender",
                    "foreground": "p:text",
                    "invert_powerline": true,
                    "powerline_symbol": "\ue0b6",
                    "options": {
                        "display_mode": "context",
                        "fetch_virtual_env": true
                    },
                    "style": "powerline",
                    "template": " \ue235 {{ .Venv }} ",
                    "type": "python"
                },
                {
                    "background": "p:blue",
                    "foreground": "p:text",
                    "powerline_symbol": "\ue0b4",
                    "style": "powerline",
                    "template": "<#fff> \ue641 </>{{ .CurrentDate | date .Format }} ",
                    "type": "time"
                }
            ],
            "type": "rprompt"
        }
    ],
    "console_title_template": "{{ .Shell }} in {{ .Folder }}",
    "final_space": false,
    "transient_prompt": {
        "background": "p:pink",
        "foreground": "p:text",
        "background_templates": [
            "{{ if .Interrupted }}p:interrupt{{ end }}"
        ],
        "template": "<background,transparent>\ue0b6</> {{ .Folder }} <background,transparent>\ue0b4 </>",
        "right_template": "<background,transparent>\ue0b6</> {{ .Segments.Time.CurrentDate | date .Segments.Time.Format }} <background,transparent>\ue0b4</>"
    },
    "version": 1
}